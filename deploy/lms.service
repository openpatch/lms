# /etc/systemd/system/lms.service
#
#   sudo systemctl enable --now lms

[Unit]
Description=Lernen mit Spass game server
After=network.target

[Service]
Type=simple
User=lms
WorkingDirectory=/srv/lms
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=DB_PATH=/srv/lms/data/lms.db
# AUTH_SECRET (required) and BASE_URL live here, outside the repository:
#   printf 'AUTH_SECRET=%s\nBASE_URL=https://lms.openpatch.org\n' "$(openssl rand -base64 32)" \
#     > /srv/lms/.env && chmod 600 /srv/lms/.env && chown lms:lms /srv/lms/.env
EnvironmentFile=/srv/lms/.env
ExecStart=/usr/bin/pnpm start
# Give the server time to flush live lobbies to SQLite before it is killed.
KillSignal=SIGTERM
TimeoutStopSec=15
Restart=always
RestartSec=2

# The process only ever needs its own directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/lms/data

[Install]
WantedBy=multi-user.target
